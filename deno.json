{
  "name": "@casys/mcp-chrono",
  "version": "0.3.0",
  "exports": {
    ".": "./mod.ts",
    "./server": "./server.ts"
  },
  "imports": {
    "@casys/mcp-server": "jsr:@casys/mcp-server@0.26.1",
    "@std/assert": "jsr:@std/assert@1.0.14"
  },
  "tasks": {
    "check": "deno check mod.ts server.ts src/**/*.ts",
    "lint": "deno lint",
    "test": "deno test -A && python3 -B -m unittest tests/container_entrypoint_test.py",
    "smoke": "deno run -A scripts/smoke.ts",
    "release:check": "deno fmt --check && deno task check && deno task lint && deno task test && deno publish --dry-run"
  },
  "fmt": {
    "exclude": ["LICENSES"],
    "lineWidth": 88,
    "indentWidth": 2,
    "singleQuote": false
  },
  "lint": { "rules": { "tags": ["recommended"] } }
}
